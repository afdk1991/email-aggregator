# 邮箱聚合平台 · 前端 nginx 配置模板
# nginx:alpine 官方入口脚本会用 envsubst 渲染 /etc/nginx/templates/*.template
# 到 /etc/nginx/conf.d/，因此 ${API_UPSTREAM} 由 docker-compose 的环境变量注入。
#
# 关键作用：前端 src/api/client.ts 以同源相对路径 `/api` 调用后端（BASE = '/api'），
# 生产镜像里没有 vite dev-server 代理，必须由 nginx 把 /api 与 /ws 反代到 Go 后端，
# 否则前端所有请求 404、页面取不到任何数据。

server {
    listen 5173;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json;

    # 单页应用路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST 接口反代到 Go 后端（宿主机进程）
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # WebSocket 实时推送（新邮件通知）
    location /ws {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
