# ============================================================
# 邮箱聚合平台 · 统一环境变量模板 (.env.example)
# 复制为 .env 放到 email-aggregator/deploy/ 与 email-aggregator-go/deploy/
# docker-compose 自动读取同目录 .env 做变量替换；
# Go 集成构建 (cmd/server_integration.go) 通过 os.Getenv 读取下方 Go 集成变量。
#
# 默认值指向 docker-compose 服务名（容器网络内解析）。
# 若从宿主机直连各服务，请把 host 改为 localhost（见各 *_HOST 注释）。
# ============================================================

# ---------- 共用：PostgreSQL (元数据) ----------
PG_USER=agg
PG_PASSWORD=agg-secret
PG_DATABASE=mailagg
PG_PORT=5432
# 宿主机直连时用 localhost: PG_HOST=localhost

# ---------- 共用：PgBouncer (连接池, 可选) ----------
PGBOUNCER_PORT=6432

# ---------- 共用：MinIO (内容对象存储, 内容寻址) ----------
MINIO_ROOT_USER=agg
MINIO_ROOT_PASSWORD=agg-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 宿主机直连时用 localhost: MINIO_HOST=localhost

# ---------- 共用：OpenSearch (检索索引) ----------
OPENSEARCH_PORT=9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Admin@123
# 宿主机直连时用 localhost

# ---------- 共用：Redpanda / Kafka (事件总线) ----------
KAFKA_PORT=9092
# 宿主机直连时用 localhost

# ---------- Go 集成构建专用 (os.Getenv，运行 go run -tags integration 前 source 本文件) ----------
PG_DSN=postgres://agg:agg-secret@postgres:5432/mailagg
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=agg-mail
MINIO_ACCESS_KEY=agg
MINIO_SECRET_KEY=agg-secret
MINIO_SECURE=false
OPENSEARCH_ADDR=http://opensearch:9200
KAFKA_BROKERS=redpanda:9092
HTTP_PORT=8080
WS_PORT=8081
