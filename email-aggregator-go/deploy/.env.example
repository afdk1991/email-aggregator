# =============================================================================
# email-aggregator-go 真实集成栈环境变量模板
# =============================================================================
# 用法：
#   cp .env.example .env
# docker compose 会自动加载同目录 .env 做变量插值（PG_USER / MINIO_ROOT_USER ...）；
# 运行 go run -tags integration ./cmd/server_integration.go 时，Go 进程也会从该
# .env 读取 PG_DSN / MINIO_* / OPENSEARCH_ADDR / KAFKA_BROKERS 等变量。
# 因此本文件同时是「基础设施」与「集成服务」两份配置的唯一来源，二者已对齐：
#   - compose 用 PG_USER=agg / PG_PASSWORD=agg-secret / PG_DATABASE=mailagg 起 PG
#   - 集成服务用 PG_DSN=postgres://agg:agg-secret@postgres:5432/mailagg 连同一库
# 凭证均为开发/PoC 占位值，生产请替换为强口令并通过密钥管理注入。
# =============================================================================

# ── PostgreSQL（compose 插值 + 集成服务 PG_DSN）──
PG_USER=agg
PG_PASSWORD=agg-secret
PG_DATABASE=mailagg
PG_PORT=5432
PGBOUNCER_PORT=6432

# ── MinIO 对象存储（compose 用 ROOT_*；集成服务用 ACCESS/SECRET）──
MINIO_ROOT_USER=agg
MINIO_ROOT_PASSWORD=agg-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── OpenSearch ──
OPENSEARCH_PORT=9200
# OpenSearch 2.x 强制要求设置初始管理员密码（security 插件默认开启）
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Kp3mQ9@vL2*rT7xA8

# ── Redpanda / Kafka ──
KAFKA_PORT=9092

# ── Phase 2 监控栈（蓝图 §10 Prometheus + Grafana + Alertmanager + exporters）──
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
POSTGRES_EXPORTER_PORT=9187
KAFKA_EXPORTER_PORT=9404

# ── Phase 2 / 蓝图 §11 服务拆分：worker 端口 ──
# sync_worker   /metrics :8081  同步编排器（订阅 sync-tasks）
# ingest_worker /metrics :8082  摄取消费侧（订阅 mail-ingested）
# search_service /metrics :8083  HTTP 检索服务（REST 端点）
SYNC_WORKER_PORT=8081
INGEST_WORKER_PORT=8082
SEARCH_SERVICE_PORT=8083

# =============================================================================
# 以下变量仅由集成服务（cmd/server_integration.go 经 env() 读取）使用；
# compose 会忽略它们（不影响基础设施启动）。
# 默认值为 Docker 网络内服务名（postgres/minio/opensearch/redpanda），
# 若在本机直接运行二进制则把主机名改为 localhost。
# =============================================================================
PG_DSN=postgres://agg:agg-secret@postgres:5432/mailagg
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=agg-mail
MINIO_ACCESS_KEY=agg
MINIO_SECRET_KEY=agg-secret
MINIO_SECURE=false
OPENSEARCH_ADDR=https://opensearch:9200
# OpenSearch security 插件启用后，写入（索引/检索）需基础鉴权；
# 与上方 OPENSEARCH_INITIAL_ADMIN_PASSWORD 保持一致（开发/PoC 用 admin 账号）。
OPENSEARCH_USER=admin
OPENSEARCH_PASS=Kp3mQ9@vL2*rT7xA8
KAFKA_BROKERS=kafka:9092
HTTP_PORT=8080
WS_PORT=8081
