# ============================================================
# 项目003 · 邮箱聚合平台 —— 根 .gitignore
# 策略：忽略构建缓存 / 产物 / 密钥 / 运行时状态；保留源码、文档、示例配置。
# ============================================================

# ---------- Go 工具链缓存（约 850MB，勿入库） ----------
.gocache/
.gopath/
**/.gocache/
**/.gopath/

# ---------- Go 构建产物 ----------
*.exe
email-agg-server
**/bin/
**/release/
**/webroot/dist/
*.log
integ_run*.log
integ-server.err.log
integ-webui.err.log
integ-webui.log

# ---------- Node / 前端 ----------
node_modules/
dist/
*.local
.DS_Store

# ---------- 密钥与本地配置（保留 .env.example） ----------
.env
**/.env
# 带后缀的 env 文件同样属于密钥范畴 —— 原先只写 `.env` 精确匹配，
# 导致 `.env.keycloak-prod`（含 KC_ADMIN_PASSWORD / KC_DB_PASSWORD / OIDC_CLIENT_SECRET）未被忽略。
**/.env.*
!**/.env.example
# 例外：前端 .env.production 只含构建期开关 VITE_DEMO_MODE，不含任何凭据，且**必须入库**——
# 它缺失会让 vite.config.ts 的 `VITE_DEMO_MODE !== 'false'` 退回 true，产出带演示模式的生产包。
!email-aggregator-web/.env.production

# ---------- Keycloak 联调临时凭据（含 access token，禁止入库） ----------
**/kc-token.json

# ---------- Agent / 工作区 / 临时 ----------
.workbuddy/
_inbox/
.ci-logs/
ts-integ.log
ts-integ.err.log
.tmp_*.txt

# ---------- Phase 4 新增：Keycloak 联调 / Docker 卷 ----------
.tmp_*/
**/.tmp_*/
email-aggregator-go/.tmp_probe/
email-aggregator-go/.tmp_q/

# ---------- IDE / 工具 ----------
.trae/
.tmp_att/
**/.edgeone/

# ---------- Docker 卷（运行时数据，勿入库） ----------
pgdata/
miniodata/
osdata/
rpdata/
cn_data/
w1_data/
w2_data/

# ---------- 报告 / 临时产物 ----------
*深度审计报告*.md
邮箱聚合平台系统架构设计.md.bak
