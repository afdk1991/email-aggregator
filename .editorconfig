# 统一编辑器编码/换行约定，避免「UTF-8 无 BOM 的 .ps1」被 PowerShell 5.1 按 GBK 误读。
# 起因：多个 .ps1 含中文注释却无 BOM，PS 5.1 解析时乱码吞引号，报
#       "字符串缺少终止符" / "意外的标记 }" 而整体不可运行。
# 详见 scripts/check-ps1-encoding.ps1。

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# PowerShell 5.1 只在有 BOM 时才按 UTF-8 解码脚本文件。
[*.ps1]
charset = utf-8-bom

[*.{psm1,psd1}]
charset = utf-8-bom

# Windows 专用脚本与批处理：CRLF 更安全
[*.{bat,cmd}]
end_of_line = crlf

[*.go]
indent_style = tab

[*.{ts,tsx,js,jsx,mjs,cjs,css,json,yml,yaml,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
