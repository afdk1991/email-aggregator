# ============================================================================
#  npm 配置（仅作用于 platforms/desktop 目录）
#
#  Electron 与 electron-builder 的二进制包默认从 GitHub Releases 下载，
#  在国内直连极易超时（表现为 npm install 卡在 electron postinstall，
#  或 electron-builder 卡在 downloading nsis / winCodeSign）。
#  这里统一指向 npmmirror 镜像；如需改用官方源或私有源，直接改本文件或
#  在命令行以 --registry / 环境变量覆盖即可。
# ============================================================================

registry=https://registry.npmmirror.com

# electron 的 postinstall 会按此地址拉取对应平台的可执行文件
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 的 winCodeSign / nsis / nsis-resources / app-builder 等工具包
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
