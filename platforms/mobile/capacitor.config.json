{
  "appId": "com.afdk1991.emailaggregator",
  "appName": "邮箱聚合平台",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#f6f7f9"
