# ============================================================
# 邮箱聚合平台 · EdgeOne Makers 部署环境变量模板
# 复制为 .env 用于本地；线上请用 `edgeone makers env set KEY VALUE` 注入，
# 或在控制台「环境变量」面板填写。切勿把真实密钥提交进仓库。
# ============================================================

# ---------- AI 能力网关（平台约定变量，Makers 会自动注入） ----------
# 不填则 AI 面板降级为本地 demo 回显（响应带 [demo] 标注，不伪造模型输出）。
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# ---------- 自托管 / 私有化后端（企业租户强制不出境路径，ADR-010） ----------
# 例：http://your-vllm-host/v1
AI_SELF_HOSTED_URL=
AI_SELF_HOSTED_MODEL=
AI_SELF_HOSTED_KEY=

# ---------- 第三方大模型（公共 SaaS 租户，需显式同意 + PII 脱敏） ----------
# 例：https://api.openai.com/v1
AI_THIRD_PARTY_URL=
AI_THIRD_PARTY_MODEL=
AI_THIRD_PARTY_KEY=

# ---------- 多租户（ADR-009） ----------
# 缺省 default；请求可用 X-Tenant-Id 头覆盖。
DEFAULT_TENANT_ID=default

# ---------- 演示模式开关（生产必须 false） ----------
# true  → 预置种子邮件、开放 /api/demo/push、AI 无上游时回显 [demo] 文案
# false → 空库起步、/api/demo/push 返回 404、AI 无上游时返回 503 而非伪造答案
# 缺省 true（兼容本地联调）；部署到生产环境时必须显式设为 false。
ENABLE_DEMO=false
